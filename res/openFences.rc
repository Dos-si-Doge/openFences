#include <winres.h>
#include "resource.h"
#include "Version.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDI_APP ICON "openFences.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION OF_VERSION_MAJOR, OF_VERSION_MINOR, OF_VERSION_PATCH, 0
 PRODUCTVERSION OF_VERSION_MAJOR, OF_VERSION_MINOR, OF_VERSION_PATCH, 0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "openFences contributors"
            VALUE "FileDescription", "openFences desktop organizer"
            VALUE "FileVersion", OF_VERSION_STRING
            VALUE "InternalName", "openFences"
            VALUE "LegalCopyright", "openFences contributors"
            VALUE "OriginalFilename", "openFences.exe"
            VALUE "ProductName", "openFences"
            VALUE "ProductVersion", OF_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
