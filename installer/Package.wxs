<?xml version="1.0" encoding="UTF-8"?>
<!--
  openFences MSI (WiX v5). Build with scripts\build.ps1, or:
    wix build installer\Package.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
        -d Version=<x.y.z> -d BinDir=build\x64-release -o out\openFences-<x.y.z>-x64.msi

  Public properties:
    AUTOSTART=1|0   start openFences when users sign in (default 1). Each user can change it later.
    AUTOUPDATE=1|0  automatically download and install updates (default 1; an upgrade keeps the earlier choice).
                    Users can change it later in Configure openFences > Updates.
    INSTALLFOLDER   installation directory (default C:\Program Files\openFences)
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="openFences"
           Manufacturer="Dos-si-Doge"
           Version="$(var.Version)"
           UpgradeCode="7B3E9A41-2C5D-4F86-A1E3-9D04C6B8F512"
           Scope="perMachine"
           Compressed="yes"
           InstallerVersion="500">

    <SummaryInformation Description="openFences desktop organizer" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of openFences is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Launch Condition="VersionNT64 &gt;= 603" Message="openFences requires 64-bit Windows 10 or Windows 11." />

    <Icon Id="openFences.ico" SourceFile="..\res\openFences.ico" />
    <!-- Advertised shortcuts need an icon whose extension matches the target file. -->
    <Icon Id="openFences.exe" SourceFile="$(var.BinDir)\openFences.exe" />
    <Property Id="ARPPRODUCTICON" Value="openFences.ico" />
    <!-- "Help" link and contact in Settings > Apps; keep in step with OF_ISSUES_URL in src/Version.h.in. -->
    <Property Id="ARPHELPLINK" Value="https://github.com/Dos-si-Doge/openFences/issues" />
    <Property Id="ARPCONTACT" Value="Dos-si-Doge" />

    <!-- Start at sign-in: checkbox in the UI, or AUTOSTART=0/1 on the command line. -->
    <Property Id="AUTOSTART" Value="1" Secure="yes" />
    <SetProperty Id="AUTOSTARTVALUE" Action="SetAutostartOn" Value="1" After="CostFinalize" Sequence="execute" Condition="AUTOSTART = &quot;1&quot;" />
    <SetProperty Id="AUTOSTARTVALUE" Action="SetAutostartOff" Value="0" After="CostFinalize" Sequence="execute" Condition="NOT (AUTOSTART = &quot;1&quot;)" />

    <!-- Automatic updates: checkbox in the UI, or AUTOUPDATE=0/1 on the command line. Ticked by default, but an upgrade
         (including the silent ones the update service runs) keeps an earlier "no": an empty property means unticked. -->
    <Property Id="AUTOUPDATE" Secure="yes" />
    <Property Id="AUTOUPDATEPREV">
      <RegistrySearch Id="PreviousAutoUpdate" Root="HKLM" Key="SOFTWARE\openFences\Update" Name="DefaultAutoUpdate" Type="raw" />
    </Property>
    <SetProperty Id="AUTOUPDATE" Action="SetAutoUpdateDefault" Value="1" After="AppSearch" Sequence="both"
                 Condition="NOT AUTOUPDATE AND NOT (AUTOUPDATEPREV = &quot;#0&quot;)" />
    <SetProperty Id="AUTOUPDATEVALUE" Action="SetAutoUpdateOn" Value="1" After="CostFinalize" Sequence="execute" Condition="AUTOUPDATE = &quot;1&quot;" />
    <SetProperty Id="AUTOUPDATEVALUE" Action="SetAutoUpdateOff" Value="0" After="CostFinalize" Sequence="execute" Condition="NOT (AUTOUPDATE = &quot;1&quot;)" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="openFences">
        <Directory Id="TemplatesFolder" Name="templates" />
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="openFences" Level="1">
      <ComponentGroupRef Id="AppFiles" />
    </Feature>

    <!-- Close a running copy before files are replaced or removed (upgrade and uninstall). -->
    <CustomAction Id="StopOpenFences" FileRef="OpenFencesExe" ExeCommand="--shutdown" Execute="immediate" Impersonate="yes" Return="ignore" />
    <!-- On uninstall, remove the current user's run-at-sign-in entry. -->
    <CustomAction Id="UnregisterAutostart" FileRef="OpenFencesExe" ExeCommand="--unregister-autostart" Execute="immediate" Impersonate="yes" Return="ignore" />
    <!-- Optional launch from the final page (runs as the user, not elevated). -->
    <CustomAction Id="LaunchOpenFences" FileRef="OpenFencesExe" ExeCommand="" Execute="immediate" Impersonate="yes" Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="StopOpenFences" Before="InstallValidate" Condition="Installed OR WIX_UPGRADE_DETECTED" />
      <Custom Action="UnregisterAutostart" After="StopOpenFences" Condition="REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <!-- UI: Welcome -> Install folder -> Options (start at sign-in) -> Ready -> Finish (launch). -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch openFences now" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <UI>
      <!-- Skip the license page and insert the options page (later Order values win). -->
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="5" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="5" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="OptionsDlg" Order="5" Condition="WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID = &quot;1&quot;" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="OptionsDlg" Order="5" Condition="NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchOpenFences" Order="5"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />

      <Dialog Id="OptionsDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="250" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Startup and updates" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="300" Height="15" Transparent="yes" NoPrefix="yes" Text="Choose whether openFences starts with Windows and keeps itself up to date." />
        <Control Id="AutostartCheck" Type="CheckBox" X="20" Y="58" Width="330" Height="18" Property="AUTOSTART" CheckBoxValue="1"
                 Text="Start openFences automatically when I sign in" />
        <Control Id="Note" Type="Text" X="37" Y="78" Width="313" Height="28" NoPrefix="yes"
                 Text="This becomes the default for every user of this PC. Anyone can change it later in Configure openFences or from the openFences tray icon." />
        <Control Id="AutoUpdateCheck" Type="CheckBox" X="20" Y="116" Width="330" Height="18" Property="AUTOUPDATE" CheckBoxValue="1"
                 Text="Automatically check for and install updates" />
        <Control Id="UpdateNote" Type="Text" X="37" Y="136" Width="313" Height="52" NoPrefix="yes"
                 Text="New versions are downloaded from GitHub and installed in the background, once they have been available for 3 days. You can change this later in Configure openFences &gt; Updates, including installing new versions immediately or how often to check." />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="InstallDirDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="VerifyReadyDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
    </UI>
  </Package>

  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable">
        <File Id="OpenFencesExe" Source="$(var.BinDir)\openFences.exe" KeyPath="yes">
          <!-- Advertised Start menu shortcut (all users). -->
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="openFences" Description="Organize your desktop into fences"
                    WorkingDirectory="INSTALLFOLDER" Advertise="yes" Icon="openFences.exe">
            <ShortcutProperty Key="System.AppUserModel.ID" Value="openFences.openFences" />
          </Shortcut>
        </File>
        <!-- Update service (app/Updater.cpp): this exe in update-service mode, started on demand by openFences, never on
             its own. The SDDL is Windows' default service DACL plus start and query rights for Users (BU: CC LC SW RP LO
             CR RC), so standard users' openFences can start a check. -->
        <ServiceInstall Id="UpdateServiceInstall" Name="openFencesUpdate" DisplayName="openFences Update Service"
                        Description="Downloads, verifies and installs openFences updates when openFences asks for them. Starts only on demand."
                        Type="ownProcess" Start="demand" Account="LocalSystem" ErrorControl="normal" Arguments="--update-service" Vital="yes">
          <PermissionEx Sddl="D:(A;;CCLCSWRPWPDTLOCRRC;;;SY)(A;;CCDCLCSWRPWPDTLOCRSDRCWDWO;;;BA)(A;;CCLCSWRPLOCRRC;;;BU)(A;;CCLCSWLOCRRC;;;IU)(A;;CCLCSWLOCRRC;;;SU)" />
        </ServiceInstall>
        <ServiceControl Id="UpdateServiceControl" Name="openFencesUpdate" Stop="both" Remove="uninstall" Wait="yes" />
        <!-- Desktop right-click menu: an "openFences" submenu (under "Show more options" on Windows 11). -->
        <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\DesktopBackground\Shell\openFences">
          <RegistryValue Name="MUIVerb" Type="string" Value="openFences" />
          <RegistryValue Name="Icon" Type="string" Value="&quot;[#OpenFencesExe]&quot;,0" />
          <RegistryValue Name="SubCommands" Type="string" Value="" />
          <RegistryValue Name="Position" Type="string" Value="Bottom" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\DesktopBackground\Shell\openFences\shell\01settings">
          <RegistryValue Name="MUIVerb" Type="string" Value="Configure openFences" />
          <RegistryValue Key="command" Type="string" Value="&quot;[#OpenFencesExe]&quot; --settings" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\DesktopBackground\Shell\openFences\shell\02newfence">
          <RegistryValue Name="MUIVerb" Type="string" Value="New fence" />
          <RegistryValue Key="command" Type="string" Value="&quot;[#OpenFencesExe]&quot; --new-fence" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\DesktopBackground\Shell\openFences\shell\03peek">
          <RegistryValue Name="MUIVerb" Type="string" Value="Peek" />
          <RegistryValue Key="command" Type="string" Value="&quot;[#OpenFencesExe]&quot; --peek" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\DesktopBackground\Shell\openFences\shell\04hide">
          <RegistryValue Name="MUIVerb" Type="string" Value="Hide or show fences" />
          <RegistryValue Key="command" Type="string" Value="&quot;[#OpenFencesExe]&quot; --toggle-hide" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\DesktopBackground\Shell\openFences\shell\05lock">
          <RegistryValue Name="MUIVerb" Type="string" Value="Lock or unlock fences" />
          <RegistryValue Key="command" Type="string" Value="&quot;[#OpenFencesExe]&quot; --toggle-lock" />
        </RegistryKey>
      </Component>
      <Files Directory="TemplatesFolder" Include="..\res\templates\*.json" />
      <!-- Opened from Settings > About > Open user guide. -->
      <Component Id="UserGuide">
        <File Id="UserGuideHtml" Source="$(var.BinDir)\openFences-User-Guide.html" KeyPath="yes" />
      </Component>
      <!-- MIT license text, opened from Settings > About > View license. -->
      <Component Id="License">
        <File Id="LicenseTxt" Source="$(var.BinDir)\LICENSE.txt" KeyPath="yes" />
      </Component>
      <!-- The install folder holds the exe the SYSTEM update service runs and the downloaded updates (Updates\), so only
           administrators and SYSTEM may change it, also when installed outside Program Files. Users read and run. -->
      <Component Id="InstallFolderAcl" Guid="9C4E2B7A-3F1D-4E68-A5B0-6D2C8E1F4A37">
        <CreateFolder>
          <PermissionEx Sddl="O:BAG:SYD:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1200a9;;;BU)(A;OICI;0x1200a9;;;AC)(A;OICI;0x1200a9;;;S-1-15-2-2)" />
        </CreateFolder>
      </Component>
      <!-- Update settings and status (app/Updater.cpp). Standard users get read and write (KEY_READ | KEY_WRITE, so
           reg.exe and PowerShell work as well as Settings > Updates); only administrators may delete the key or change
           its permissions. DefaultAutoUpdate is the installer's choice; "Enabled" (written by
           Settings) overrides it. -->
      <Component Id="UpdateSettings">
        <RegistryKey Root="HKLM" Key="SOFTWARE\openFences\Update" ForceCreateOnInstall="yes">
          <PermissionEx Sddl="D:PAI(A;CI;KA;;;SY)(A;CI;KA;;;BA)(A;CI;0x2001f;;;BU)" />
          <RegistryValue Name="DefaultAutoUpdate" Type="integer" Value="[AUTOUPDATEVALUE]" KeyPath="yes" />
        </RegistryKey>
      </Component>
      <!-- Machine default for "start at sign-in"; applied to each user's HKCU Run key on their first run. -->
      <Component Id="AutostartDefault">
        <RegistryValue Root="HKLM" Key="SOFTWARE\openFences" Name="DefaultAutostart" Type="integer" Value="[AUTOSTARTVALUE]" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\openFences" Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" />
      </Component>
    </ComponentGroup>
  </Fragment>

</Wix>
